# Sao chép thành .env, thay thông tin trước khi triển khai. Không commit .env.
DOMAIN=ha-tang.example.vn
PUBLIC_ORIGIN=https://ha-tang.example.vn
COOKIE_SECURE=1
# Tự tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=
PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data
# New empty database only; set actual values in Render Environment, never commit secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 24 random characters, consumed once per recovery; change for another recovery.
RECOVERY_TOKEN=
